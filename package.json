{
    "name": "@drawdy/driver-protocol",
    "version": "0.1.5",
    "license": "MIT",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/drawdyio/drawdy-driver-protocol.git"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "typecheck": "tsc --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "prepublishOnly": "npm run build",
        "test": "jest --passWithNoTests",
        "docs:dev": "pnpm --filter drawdy-driver-protocol-docs dev",
        "bump": "node bump.mjs",
        "docs:validate": "pnpm --filter drawdy-driver-protocol-docs validate"
    },
    "devDependencies": {
        "typescript": "^5"
    }
}
