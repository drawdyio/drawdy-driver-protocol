{
    "name": "drawdy-cli",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "bin": {
        "drawdy": "./dist/index.js"
    },
    "scripts": {
        "dev": "tsx src/index.ts",
        "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --banner:js='#!/usr/bin/env node' --outfile=dist/index.js",
        "test": "vitest --run"
    },
    "devDependencies": {
        "@types/node": "^20",
        "esbuild": "^0.25.0",
        "tsx": "^4.19.2",
        "typescript": "^5",
        "vitest": "^1.0.0"
    }
}
