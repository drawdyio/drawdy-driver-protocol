{
    "$schema": "https://mintlify.com/docs.json",
    "theme": "mint",
    "name": "Drawdy Driver Protocol",
    "description": "The Drawdy Driver Protocol (DDP) is the open API for building Drawdy extensions: JavaScript drivers that draw on the canvas and add menus and panels.",
    "colors": {
        "primary": "#597100",
        "light": "#bceb00",
        "dark": "#597100"
    },
    "appearance": {
        "default": "dark"
    },
    "background": {
        "color": {
            "light": "#ffffff",
            "dark": "#18181b"
        }
    },
    "fonts": {
        "heading": {
            "family": "Google Sans Flex",
            "weight": 600
        },
        "body": {
            "family": "Google Sans Flex",
            "weight": 400
        }
    },
    "styling": {
        "codeblocks": "system"
    },
    "seo": {
        "organization": {
            "id": "https://drawdy.io/#organization",
            "name": "Drawdy",
            "url": "https://drawdy.io",
            "logo": "https://drawdy.io/landing/logo.webp",
            "sameAs": [
                "https://github.com/drawdyio"
            ]
        },
        "indexing": "all"
    },
    "thumbnails": {
        "fonts": {
            "family": "Google Sans Flex"
        }
    },
    "favicon": "/favicon.svg",
    "logo": {
        "light": "/logo/light.svg",
        "dark": "/logo/dark.svg"
    },
    "navigation": {
        "groups": [
            {
                "group": "Guide",
                "pages": [
                    "index",
                    "quickstart",
                    "examples"
                ]
            },
            {
                "group": "Protocol reference",
                "pages": [
                    "protocol/overview",
                    "protocol/permissions",
                    "protocol/commands",
                    "protocol/subscriptions",
                    "protocol/webview-api",
                    "protocol/data-types"
                ]
            }
        ]
    },
    "navbar": {
        "links": [
            {
                "label": "Extension marketplace",
                "href": "https://drawdy.io/extensions"
            },
            {
                "label": "GitHub",
                "href": "https://github.com/drawdyio/drawdy-driver-protocol"
            }
        ],
        "primary": {
            "type": "button",
            "label": "Open Drawdy",
            "href": "https://drawdy.io"
        }
    },
    "contextual": {
        "options": [
            "copy",
            "view",
            "chatgpt",
            "claude",
            "perplexity",
            "mcp",
            "cursor",
            "vscode"
        ]
    },
    "footer": {
        "socials": {
            "website": "https://drawdy.io",
            "github": "https://github.com/drawdyio/drawdy-driver-protocol"
        }
    },
    "redirects": [
        {
            "source": "/intro",
            "destination": "/"
        },
        {
            "source": "/protocol",
            "destination": "/protocol/overview"
        }
    ]
}
